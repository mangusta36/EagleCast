# Canonical production host (live site resolves here).
# Keep this in sync with data/seo.ts -> SITE_URL and with the Vercel domain you attach.
NEXT_PUBLIC_SITE_URL=https://www.eaglecastv.online

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Empty = analytics disabled.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification meta token (e.g. abc123xyz...).
# Optional — set when you want the verification <meta> tag rendered in <head>.
NEXT_PUBLIC_GSC_VERIFICATION=

# Support inbox used by the contact form.
CONTACT_EMAIL_TO=support@eaglecast.tv
